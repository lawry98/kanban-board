// ─── RLS posture (team decision — read this before assuming a DB backstop) ────
//
// Row Level Security is ENABLED on every table and its policies were repaired in
// migration 20260721000000_review_fixes. It exists for exactly one reason: so
// Supabase Realtime (postgres_changes) can authorize per-subscriber reads.
//
// RLS does NOT protect application data. Prisma connects over DATABASE_URL as
// the `postgres` role, which owns these tables and has BYPASSRLS — so every
// query issued from a Server Component or Server Action bypasses every policy.
//
// Authorization is enforced in application code, in the server actions, via
// `lib/auth/require-access.ts`. When you add a server action you MUST call the
// access check yourself. The database will not catch a missing check for you.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  EDITOR
  VIEWER
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Action {
  TASK_CREATED
  TASK_MOVED
  TASK_UPDATED
  TASK_DELETED
  COLUMN_CREATED
  COLUMN_UPDATED
  COLUMN_DELETED
  BOARD_CREATED
  BOARD_UPDATED
  BOARD_DELETED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Profile {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  boards          Board[]
  boardMembers    BoardMember[]
  tasksCreated    Task[]           @relation("TaskCreatedBy")
  tasksAssigned   Task[]           @relation("TaskAssignee")
  activityLogs    ActivityLog[]
  invitations     Invitation[]
  analyticsEvents AnalyticsEvent[]

  @@map("profiles")
}

model Board {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // NOTE: left as Cascade deliberately — deleting a profile deletes the boards
  // they own, and with them the columns/tasks/members/logs beneath. This is the
  // intended "delete my account, delete my boards" behaviour, but it is
  // destructive for collaborators who are members of those boards. If account
  // deletion becomes user-facing, revisit this (ownership transfer or soft
  // delete) rather than letting a single DELETE take out other people's work.
  creator      Profile       @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  members      BoardMember[]
  columns      Column[]
  tasks        Task[]
  activityLogs ActivityLog[]
  invitations  Invitation[]

  @@index([createdBy])
  @@map("boards")
}

model BoardMember {
  id       String   @id @default(uuid())
  boardId  String   @map("board_id")
  userId   String   @map("user_id")
  role     Role     @default(VIEWER)
  joinedAt DateTime @default(now()) @map("joined_at")

  board   Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
  @@map("board_members")
}

model Invitation {
  id        String    @id @default(uuid())
  boardId   String    @map("board_id")
  role      Role      @default(VIEWER)
  // Unguessable, server-generated (crypto.randomBytes). The unique index is the
  // lookup path for the join flow.
  token     String    @unique
  // Optional targeting: unused by the reusable-link MVP, but present so email
  // invitations can be added later without another migration.
  email     String?
  invitedBy String    @map("invited_by")
  // A link with no expiry never lapses; revocation is via revokedAt.
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  board   Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  inviter Profile @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@map("invitations")
}

/// First-party product analytics. Deliberately NOT `activity_logs`: that table's
/// board_id is NOT NULL and cascades on board delete, which would erase the
/// churned cohort's activation history — the exact population an activation
/// metric exists to study. See docs/superpowers/specs/2026-07-28-product-analytics-design.md §3.3.
model AnalyticsEvent {
  id         String   @id @default(uuid())
  /// Free-form by design — NOT a Postgres enum, so adding an event type never
  /// needs a migration. Type safety lives in lib/analytics/events.ts.
  name       String
  /// Nullable + SetNull: an erasure request deletes the profile and leaves the
  /// events intact but unattributable.
  userId     String?  @map("user_id")
  /// Deliberately a plain column with NO foreign key. An FK would cascade on
  /// board deletion and erase the churned cohort's activation history.
  boardId    String?  @map("board_id")
  properties Json     @default("{}")
  /// Idempotency handle for once-per-period events. NULL for ordinary events;
  /// Postgres treats NULLs as distinct in a unique index, so any number coexist.
  dedupeKey  String?  @unique @map("dedupe_key")
  occurredAt DateTime @default(now()) @map("occurred_at")

  profile Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, occurredAt])
  @@index([userId, occurredAt])
  @@map("analytics_events")
}

model Column {
  id        String   @id @default(uuid())
  boardId   String   @map("board_id")
  title     String
  // Fractional: a reorder is a single-row update to the midpoint between
  // neighbours, rather than renumbering every sibling.
  position  Float
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId])
  @@index([boardId, position])
  @@map("columns")
}

model Task {
  id          String    @id @default(uuid())
  columnId    String    @map("column_id")
  boardId     String    @map("board_id")
  title       String
  description String?
  // Fractional: see Column.position.
  position    Float
  priority    Priority  @default(NONE)
  labels      String[]
  // A calendar day, not an instant: Prisma reads it as UTC midnight. See lib/dates.ts.
  dueDate     DateTime? @map("due_date") @db.Date
  assigneeId  String?   @map("assignee_id")
  // Nullable + SetNull: deleting a profile must not destroy tasks that user
  // created on other people's boards. NULL means "created by a deleted user".
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  column   Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  board    Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  assignee Profile? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  Profile? @relation("TaskCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([columnId, position])
  @@index([boardId])
  @@index([assigneeId])
  @@index([createdBy])
  @@map("tasks")
}

model ActivityLog {
  id         String   @id @default(uuid())
  boardId    String   @map("board_id")
  // Nullable + SetNull: deleting a profile must not erase the audit trail.
  userId     String?  @map("user_id")
  action     Action
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  board   Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
  @@index([userId])
  @@map("activity_logs")
}
