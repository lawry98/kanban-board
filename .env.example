# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- Database (Prisma) ---
# Supabase transaction pooler (port 6543) — used by the app at runtime on serverless.
DATABASE_URL=
# Supabase direct connection (port 5432) — used by `prisma migrate`.
DIRECT_URL=

# --- Supabase (Auth + Realtime only; all DB access goes through Prisma) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional ---
# PEM-encoded CA certificate for verifying the Postgres TLS connection. Replaces
# the Supabase Root 2021 CA bundled in lib/db-tls.ts — only needed if Supabase
# rotates its root or you point DATABASE_URL at a non-Supabase Postgres.
# SUPABASE_CA_CERT=

# Sentry error monitoring. All unset → Sentry is fully inert (no SDK init, no
# source maps generated or uploaded) and the build still passes.
# Client DSN. Inlined into the browser bundle at build time, so changing it needs a redeploy.
# NEXT_PUBLIC_SENTRY_DSN=
# Server/edge DSN. Falls back to NEXT_PUBLIC_SENTRY_DSN when unset.
# SENTRY_DSN=
# Build-time secret for source-map upload. Never prefix it with NEXT_PUBLIC_.
# SENTRY_AUTH_TOKEN=
# Org and project slugs the source maps are uploaded to.
# SENTRY_ORG=
# SENTRY_PROJECT=
